# Copy to .env; use the same internal token for Python and the PHP container.
# For an existing database, retain its current database passwords.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=DoAn_ChamCong_AI_MariaDB
MARIADB_USER=pbl4_user
MARIADB_PASSWORD=
PBL4_INTERNAL_TOKEN=
PBL4_UPLOAD_TOKEN=
PBL4_UPLOAD_BIND_HOST=127.0.0.1
PBL4_UPLOAD_PORT=5000
PBL4_DEVICE_ID=1
AI_BIND_HOST=0.0.0.0
AI_PORT=5001
# Desktop uses the service camera; select local only when the service is stopped.
PBL4_CAMERA_MODE=relay
PBL4_CAMERA_ID=0
PBL4_CAMERA_BACKEND=dshow
PBL4_AI_URL=http://127.0.0.1:5001
PBL4_WEB_API=http://localhost:8080/api/chamcong
WEB_GALLERY_URL=http://localhost:8080/?action=internal_face_gallery
