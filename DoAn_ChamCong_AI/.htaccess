<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Khong rewrite neu la file hoac thu muc that (nhu /public/css, /public/js)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Dieu huong tat ca request con lai ve index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
